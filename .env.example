# ==============================================================================
# Database (PostgreSQL)
# ==============================================================================
APP__DB__HOST=postgres
APP__DB__NAME=viridi_db
APP__DB__USER=viridi_user
APP__DB__PASSWORD=change_this_to_a_strong_password

# ==============================================================================
# Redis & RabbitMQ
# ==============================================================================
REDIS_URL=redis://redis:6379

RABBITMQ_USER=viridi_rabbit
RABBITMQ_PASSWORD=change_this_to_a_strong_password
RABBITMQ_URL=amqp://viridi_rabbit:change_this_to_a_strong_password@rabbitmq:5672/

# ==============================================================================
# Security & Tokens
# ==============================================================================
SECRET_KEY=change_this_to_a_random_secret_key
INVITE_CODE_SECRET_KEY=change_this_to_a_base64_encoded_32_byte_key=

# ==============================================================================
# MinIO Object Storage
# ==============================================================================
MINIO_ROOT_USER=viridi_minio_admin
MINIO_ROOT_PASSWORD=change_this_to_a_strong_password

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=viridi_minio_admin
MINIO_SECRET_KEY=change_this_to_a_strong_password
MINIO_SECURE=false

# ==============================================================================
# Monitoring (Grafana)
# ==============================================================================
GRAFANA_ADMIN_USER=viridi_admin
GRAFANA_ADMIN_PASSWORD=change_this_to_a_strong_password

# ==============================================================================
# Telegram & Application
# ==============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEB_APP_URL=https://your-domain.com
MIN_DELIVERY_DAYS_OFFSET=1
