      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "clamp_min(((sum(rate(http_requests_total{status_code=~\"5..\"}[1m])) or sum(rate(http_requests_total{status=~\"5..\"}[1m])) or vector(0)) / (sum(rate(http_requests_total[1m])) or sum(rate(http_request_duration_seconds_count[1m])) or vector(1))) * 100, 0)",
