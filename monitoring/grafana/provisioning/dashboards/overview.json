        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total[1m])) or sum(rate(http_request_duration_seconds_count[1m])) or vector(0)",
